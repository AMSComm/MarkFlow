{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkFlow",
  "version": "0.1.0",
  "identifier": "com.markflow.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkFlow",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AM Software",
    "copyright": "Copyright © 2026 AM Software",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5NjgwRDUyMzU3RkVERgpSV1RmL2xjajFZQ1dEZjlTc29pNkJUTnpidnVhckdqbDJTbGhtN1g0TURFOFNKYzNHclVFeC9VYwo=",
      "endpoints": [
        "https://github.com/AMSComm/MarkFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
